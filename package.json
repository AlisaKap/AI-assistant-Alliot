{
  "name": "alliot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check-package-json": "ncu",
    "dev": "cross-env APP_PROFILE=dev tauri dev",
    "dev:mock": "cross-env VITE_MOCK_API=true vite",
    "lint": "eslint --fix",
    "lint:fsd": "steiger ./src",
    "orval": "orval",
    "prettier": "prettier \"src/**/*.{css,scss}\" --write",
    "preview": "vite preview",
    "sort-package-json": "sort-package-json",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:build": "cross-env VITE_E2E=true tauri build --debug",
    "test:e2e": "bun run test:e2e:build && wdio run wdio.conf.ts",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "update-package-json": "bun update"
  },
